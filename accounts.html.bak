<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title data-i="pageTitleAccounts">Accounts — Ledgerline</title>
<meta name="description" content="Browse accounts listed by Ledgerline.">
<link rel="icon" type="image/x-icon" href="favicon.ico">
<script>(function(){var m='auto',e=document.documentElement;try{m=localStorage.getItem('thm')||'auto'}catch(x){}var d=matchMedia('(prefers-color-scheme:dark)').matches;e.setAttribute('data-theme',m==='auto'?(d?'dark':'light'):m);e.setAttribute('data-mode',m)})();</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="site.css">
<style>
:root{--bg:#fafaf7;--surface:#fff;--ink:#0e0f0c;--mute:#6b6d66;--line:#e6e6e0;--accent:#0e0f0c;--accent-ink:#fff;--soft:#f1f1ec;box-sizing:border-box}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0b0c0a;--surface:#131411;--ink:#f3f3ee;--mute:#9a9c94;--line:#24251f;--accent:#f3f3ee;--accent-ink:#0b0c0a;--soft:#1a1b17}}
:root[data-theme="dark"]{--bg:#0b0c0a;--surface:#131411;--ink:#f3f3ee;--mute:#9a9c94;--line:#24251f;--accent:#f3f3ee;--accent-ink:#0b0c0a;--soft:#1a1b17}
*{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Plus Jakarta Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
.wrap{width:min(1120px,100%);margin:0 auto;padding:0 20px}
.top{position:sticky;top:0;z-index:5;background:color-mix(in srgb,var(--bg) 90%,transparent);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.top-row{min-height:66px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{display:flex;align-items:center;gap:9px;color:var(--ink);text-decoration:none;font-size:19px;font-weight:800;white-space:nowrap}
.brand-mark{width:24px;height:24px;border-radius:7px;background:var(--accent);position:relative}
.brand-mark:after{content:"";position:absolute;left:6px;right:6px;top:11px;height:2px;background:var(--accent-ink);border-radius:2px}
.desktop-nav{display:flex;align-items:center;gap:26px}
.nav-link{color:var(--mute);text-decoration:none;font-size:14px;white-space:nowrap}
.nav-link:hover,.nav-link[aria-current=page]{color:var(--ink)}
.nav-link[aria-current=page]{pointer-events:none}
.mobile-nav{display:none}
.theme{width:38px;height:38px;border:1px solid var(--line);border-radius:50%;background:var(--surface);color:var(--ink);font:inherit;cursor:pointer}
.main{max-width:820px;margin:0 auto;padding:88px 20px 120px}
.eyebrow{font:12px 'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.08em;color:var(--mute)}
h1{font-size:clamp(34px,5vw,56px);letter-spacing:-.04em;line-height:1.05;margin:12px 0}
.intro,.post-summary{color:var(--mute);line-height:1.7}
.status{margin-top:32px;padding:24px;line-height:1.6;color:var(--mute);background:var(--surface);border:1px solid var(--line);border-radius:16px}
.articles{display:grid;gap:24px;margin-top:24px}
.post{padding:clamp(20px,4vw,32px);background:var(--surface);border:1px solid var(--line);border-radius:20px}
.post img{width:100%;height:auto;max-height:420px;object-fit:cover;border-radius:12px}
.post h2{font-size:clamp(22px,3vw,30px);letter-spacing:-.03em;line-height:1.2;margin:16px 0 8px}
.post time{font:12px 'JetBrains Mono',monospace;color:var(--mute)}
[hidden]{display:none!important}
@media(max-width:767px){.wrap{padding-inline:16px}.desktop-nav{display:none}.mobile-nav{display:flex;gap:24px;overflow-x:auto;padding:0 16px 12px;border-top:1px solid var(--line);scrollbar-width:none}.mobile-nav::-webkit-scrollbar{display:none}.main{padding:64px 16px 96px}}
</style>
</head>
<body>
<nav class="top" aria-label="Main navigation">
  <div class="wrap top-row">
    <a class="brand" href="funnel.html"><span class="brand-mark" aria-hidden="true"></span>Ledgerline</a>
    <div class="desktop-nav">
      <a class="nav-link" href="funnel.html" data-i="navHome">Home</a>
      <a class="nav-link" href="feedbacks.html" data-i="navFeedbacks">Feedbacks</a>
      <a class="nav-link" href="accounts.html" aria-current="page" data-i="navAccounts">Accounts</a>
    </div>
    <div class="top-controls">
      <select id="language" class="site-language" aria-label="Language"><option value="auto">Auto</option><option value="en">English</option><option value="fr">Français</option><option value="es">Español</option><option value="ar">العربية</option><option value="zh">中文</option></select>
      <button class="theme" id="theme" type="button" aria-label="Change color theme" title="Auto, light, or dark theme"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.2 15.4A8.5 8.5 0 018.6 3.8 8.5 8.5 0 1020.2 15.4Z"/></svg></button>
      <a class="site-header-cta" href="funnel.html#start" data-i="cta">Buy Account</a>
    </div>
  </div>
  <div class="mobile-nav" aria-label="More navigation">
    <a class="nav-link" href="funnel.html" data-i="navHome">Home</a>
    <a class="nav-link" href="feedbacks.html" data-i="navFeedbacks">Feedbacks</a>
    <a class="nav-link" href="accounts.html" aria-current="page" data-i="navAccounts">Accounts</a>
  </div>
</nav>
<main class="main">
  <div class="eyebrow" data-i="accountsEyebrow">Listings</div>
  <h1 data-i="accountsTitle">Accounts</h1>
  <p class="intro" data-i="accountsIntro">Browse accounts listed by Ledgerline.</p>
  <p class="status" id="accounts-status" data-locale-text="accountsLoading" role="status" aria-live="polite">Loading accounts…</p>
  <div class="articles" id="accounts-list"></div>
  <a href="https://t.me/buyshopifypayments" data-i="telegramLink" style="display:block;margin:24px auto 0;padding:12px 24px;background:var(--accent);color:var(--accent-ink);text-decoration:none;border-radius:999px;font-weight:600;text-align:center">Visit our Telegram community</a>
</main>
<footer class="site-footer"><div class="site-footer-inner">
  <div class="site-footer-grid">
    <div class="site-footer-about"><a class="site-footer-brand" href="funnel.html">Ledgerline</a><p data-i="footerDescription">Pre-verified and warmed Stripe and Shopify accounts for online businesses.</p></div>
    <div class="site-footer-col"><h2 data-i="footerExplore">Explore</h2><ul class="site-footer-links"><li><a href="funnel.html#process" data-i="footerProcess">Process</a></li><li><a href="funnel.html#faq" data-i="footerFaq">FAQ</a></li><li><a href="blog.html" data-i="footerBlog">Blog</a></li><li><a href="funnel.html#start" data-i="footerContact">Contact</a></li></ul></div>
    <div class="site-footer-col"><h2 data-i="footerCommunity">Community</h2><ul class="site-footer-links"><li><a href="feedbacks.html" data-i="footerFeedbacks">Feedbacks</a></li><li><a href="accounts.html" data-i="footerAccounts">Accounts</a></li><li><a href="aboutus.html" data-i="footerAbout">About</a></li></ul></div>
    <div class="site-footer-col"><h2 data-i="footerPolicies">Policies</h2><ul class="site-footer-links"><li><a href="policy.html" data-i="footerPoliciesLink">Policies</a></li><li><a href="refund.html" data-i="footerRefund">Refund policy</a></li></ul></div>
  </div>
  <div class="site-footer-bottom"><span data-i="footerCopyright">© 2026 Ledgerline</span><span data-i="footerDisclaimer">Not affiliated with Stripe or Shopify. Their names and marks belong to their respective owners.</span></div>
</div></footer>
<script src="site-locale.js"></script>
<script src="blog-config.js"></script>
<script>
(function(){
  var button=document.getElementById('theme'),mode=document.documentElement.getAttribute('data-mode')||'auto';
  button.addEventListener('click',function(){
    mode=mode==='auto'?'light':mode==='light'?'dark':'auto';
    document.documentElement.setAttribute('data-mode',mode);
    if(mode==='auto'){document.documentElement.removeAttribute('data-theme')}else{document.documentElement.setAttribute('data-theme',mode)}
    try{mode==='auto'?localStorage.removeItem('thm'):localStorage.setItem('thm',mode)}catch(e){}
  });
})();
(function(){
  var status=document.getElementById('accounts-status'),list=document.getElementById('accounts-list');
  function setStatus(key){status.setAttribute('data-locale-text',key);status.textContent=window.LedgerlineLocale.text(key);}
  var config=window.LEDGERLINE_BLOG_CONFIG||{};
  if(!config.supabaseUrl||!config.publishableKey){
    setStatus('accountsNotConnected');
    return;
  }
  var endpoint=config.supabaseUrl.replace(/\/$/,'')+'/rest/v1/accounts?select=title,description,image,created_at&order=created_at.desc&limit=50';
  fetch(endpoint,{headers:{apikey:config.publishableKey,Authorization:'Bearer '+config.publishableKey}})
    .then(function(response){
      if(!response.ok)throw new Error('Accounts request failed with status '+response.status);
      return response.json();
    })
    .then(function(accounts){
      if(!Array.isArray(accounts))throw new Error('Accounts response was not a list');
      if(accounts.length===0){setStatus('accountsEmpty');return;}
      status.hidden=true;
      accounts.forEach(function(account){
        var article=document.createElement('article');
        article.className='post';
        if(account.image){
          var img=document.createElement('img');
          img.src=account.image;
          img.alt=account.title||'Account listing';
          img.loading='lazy';
          article.appendChild(img);
        }
        var title=document.createElement('h2');
        title.textContent=account.title||'Account listing';
        var summary=document.createElement('p');
        summary.className='post-summary';
        summary.textContent=account.description||'';
        article.append(title,summary);
        if(account.created_at){
          var time=document.createElement('time');
          time.dateTime=account.created_at;
          var created=new Date(account.created_at);
          time.textContent=Number.isNaN(created.getTime())?'':created.toLocaleDateString(undefined,{year:'numeric',month:'long',day:'numeric'});
          article.appendChild(time);
        }
        list.appendChild(article);
      });
    })
    .catch(function(error){
      console.error('Unable to load accounts:',error);
      setStatus('accountsLoadError');
    });
})();
</script>
</body>
</html>
